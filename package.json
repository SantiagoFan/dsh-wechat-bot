{
  "name": "@mindlink/wechat-bot",
  "version": "1.0.0",
  "private": false,
  "publishConfig": { "access": "public" },
  "author": "思链科技（MindLink）",
  "license": "MIT",
  "type": "module",
  "description": "Personal WeChat bot via the official iLink (ClawBot) channel: sidebar status panel, account info, and an agent tool that pushes the daily brief to your WeChat.",
  "keywords": ["dsh-plugin", "dsh", "wechat", "wechat-bot", "ilink", "clawbot"],
  "engines": { "node": ">=20" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "bridge/ilink.js",
    "bridge/render.js",
    "vendor/qrcode.cjs",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
